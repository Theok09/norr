#!/bin/bash

CONFIG_DIR="${NORR_CONFIG_DIR:-/etc/norr}"
NORR_CLI="${NORR_CLI:-norr}"
PROBE_PORT=2053
[ -r "$CONFIG_DIR/failover.conf" ] && . "$CONFIG_DIR/failover.conf"

PASS=0; WARN=0; FAIL=0
ok()   { printf '  \033[32mPASS\033[0m %s\n' "$*"; PASS=$((PASS+1)); }
warn() { printf '  \033[33mWARN\033[0m %s\n' "$*"; WARN=$((WARN+1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$*"; FAIL=$((FAIL+1)); }
hdr()  { printf '\n=== %s ===\n' "$*"; }

NDPARSE=$(mktemp /tmp/norr-doctor.XXXXXX.py)
trap 'rm -f "$NDPARSE"' EXIT
cat > "$NDPARSE" <<'PYEOF'
import sys,re
name=sys.argv[1]; off=int(sys.argv[2])
pkts=[]; cur=""
for line in sys.stdin:
    if re.match(r"\d\d:\d\d:\d\d", line) or " IP " in line:
        if cur: pkts.append(cur); cur=""
        continue
    m=re.search(r"0x[0-9a-f]+:\s*(.*)", line)
    if m: cur+=re.sub(r"[^0-9a-f]", "", m.group(1).lower())
if cur: pkts.append(cur)
sigs=[p[off*2:(off+6)*2] for p in pkts if len(p)>=(off+6)*2]
if len(sigs)<2: print(f"  WARN {name}: too few samples ({len(sigs)})"); sys.exit()
uniq=len(set(sigs))
if uniq==1: print(f"  FAIL {name}: fixed prefix {sigs[0]} across {len(sigs)} pkts (SPOOF LEAK)")
else: print(f"  PASS {name}: obf prefix varies ({uniq}/{len(sigs)} distinct)")
PYEOF

declare -a NAMES
declare -A ROLE KIND PEER PORT
while read -r name role kind peer port tun; do
  [ -z "$name" ] && continue
  NAMES+=("$name"); ROLE[$name]=$role; KIND[$name]=$kind; PEER[$name]=$peer; PORT[$name]=$port
done < <("$NORR_CLI" tunnels --machine 2>/dev/null)

if [ ${#NAMES[@]} -eq 0 ]; then
  echo "no tunnels configured in $CONFIG_DIR"
  exit 2
fi

pid_of() { pgrep -f "run $CONFIG_DIR/$1.toml\$" | head -1; }

hdr "services"
for s in "${NAMES[@]}"; do
  st=$(systemctl is-active "norr@$s" 2>/dev/null)
  nr=$(systemctl show "norr@$s" -p NRestarts --value 2>/dev/null)
  if [ "$st" = active ]; then
    [ "${nr:-0}" -gt 3 ] && warn "norr@$s active but $nr restarts" || ok "norr@$s active (restarts=${nr:-0})"
  else
    bad "norr@$s is ${st:-unknown}"
  fi
done

hdr "cpu (busy-spin regression)"
for s in "${NAMES[@]}"; do
  pid=$(pid_of "$s"); [ -z "$pid" ] && continue
  pcpu=$(ps -o pcpu= -p "$pid" | tr -d ' ')
  if awk "BEGIN{exit !($pcpu>40)}"; then bad "$s CPU ${pcpu}% (possible busy-spin)"
  elif awk "BEGIN{exit !($pcpu>15)}"; then warn "$s CPU ${pcpu}%"
  else ok "$s CPU ${pcpu}%"; fi
done

hdr "tcp listen backlog (must be 0)"
listening=0
for s in "${NAMES[@]}"; do
  case "${KIND[$s]}" in tcp | camo) ;; *) continue ;; esac
  [ "${ROLE[$s]}" = server ] || continue
  listening=1
  p=${PORT[$s]}
  rq=$(ss -tlnH "( sport = :$p )" 2>/dev/null | awk '{print $2}' | head -1)
  if [ -z "$rq" ]; then bad "$s (${KIND[$s]} $p) is not listening"
  elif [ "$rq" -eq 0 ]; then ok "$s (${KIND[$s]} $p) backlog 0"
  else bad "$s (${KIND[$s]} $p) backlog $rq (accept not draining)"; fi
done
[ $listening -eq 0 ] && ok "no TCP listeners on this node (client side)"

hdr "fd / memory (leak check)"
for s in "${NAMES[@]}"; do
  pid=$(pid_of "$s"); [ -z "$pid" ] && continue
  fds=$(ls /proc/"$pid"/fd 2>/dev/null | wc -l)
  rss=$(ps -o rss= -p "$pid" | tr -d ' '); rssm=$((rss/1024))
  [ "$fds" -gt 200 ] && bad "$s fds=$fds (leak?)" || ok "$s fds=$fds rss=${rssm}MB"
done

hdr "reachability + latency (peer port $PROBE_PORT)"
probed=0
for s in "${NAMES[@]}"; do
  [ "${ROLE[$s]}" = client ] || continue
  probed=1
  ip=${PEER[$s]}; ok_n=0; sum=0
  for _ in 1 2 3 4 5; do
    t0=$(date +%s%N)
    if timeout 2 bash -c "echo >/dev/tcp/$ip/$PROBE_PORT" 2>/dev/null; then
      t1=$(date +%s%N); ok_n=$((ok_n+1)); sum=$((sum+(t1-t0)/1000000)); fi
  done
  if [ $ok_n -eq 0 ]; then bad "$s ${KIND[$s]} ($ip:$PROBE_PORT) unreachable now"
  else
    avg=$((sum/ok_n)); loss=$(((5-ok_n)*20))
    [ $loss -gt 40 ] && warn "$s ${KIND[$s]} loss=${loss}% rtt=${avg}ms" || ok "$s ${KIND[$s]} loss=${loss}% rtt=${avg}ms"
  fi
done
[ $probed -eq 0 ] && ok "server side: reachability is measured from the client"

hdr "failover controller"
act=$(cat /run/norr-failover.active 2>/dev/null)
if [ -n "$act" ]; then ok "failover active=$act"
elif systemctl is-active --quiet norr-failover.timer 2>/dev/null; then warn "failover timer on but no transport selected yet"
else ok "failover not running on this node"; fi
[ -f /run/norr-failover.metrics ] && sed 's/^/    /' /run/norr-failover.metrics

hdr "wire inspection (obfuscation must not leak a fixed prefix)"
check_wire() {
  local name=$1 tun=$2 proto=$3 pubip=$4 pubport=$5 off=$6
  ( for _ in $(seq 1 30); do timeout 1 bash -c "echo >/dev/tcp/$tun/$PROBE_PORT" 2>/dev/null; done ) &
  local gen=$!
  local filt="$proto and host $pubip and port $pubport"
  [ "$proto" = icmp ] && filt="icmp and host $pubip"
  local cap; cap=$(timeout 7 tcpdump -i any -n -c 8 -xx "$filt" 2>/dev/null)
  kill $gen 2>/dev/null; wait 2>/dev/null
  [ -z "$cap" ] && { warn "$name: no packets captured (idle or filtered)"; return; }
  local verdict; verdict=$(printf "%s\n" "$cap" | python3 "$NDPARSE" "$name" "$off")
  echo "$verdict"
  case "$verdict" in
    *FAIL*) FAIL=$((FAIL+1));;
    *WARN*) WARN=$((WARN+1));;
    *PASS*) PASS=$((PASS+1));;
  esac
}
if ! command -v tcpdump >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
  warn "tcpdump and python3 are needed for wire inspection"
else
  inspected=0
  for s in "${NAMES[@]}"; do
    ep=$(awk -F'"' '/^endpoint *=/ {print $2; exit}' "$CONFIG_DIR/$s.toml")
    [ -z "$ep" ] && continue
    case "${KIND[$s]}" in
      udp) proto=udp; off=48 ;;
      camo) proto=tcp; off=80 ;;
      icmp) proto=icmp; off=48 ;;
      *) continue ;;
    esac
    inspected=1
    check_wire "$s ${KIND[$s]}" "${PEER[$s]}" "$proto" "${ep%:*}" "${ep##*:}" "$off"
  done
  [ $inspected -eq 0 ] && ok "server side: the wire is inspected from the dialling client"
fi

hdr "summary"
printf '  PASS=%d  WARN=%d  FAIL=%d\n' "$PASS" "$WARN" "$FAIL"
[ "$FAIL" -gt 0 ] && exit 2
[ "$WARN" -gt 0 ] && exit 1
exit 0
