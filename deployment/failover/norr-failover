#!/bin/bash

CONFIG_DIR="${NORR_CONFIG_DIR:-/etc/norr}"
NORR_CLI="${NORR_CLI:-norr}"
STATE=/run/norr-failover.active
HYST=/run/norr-failover.hyst
METRICS=/run/norr-failover.metrics

PROBE_PORT=2053
ORDER="udp camo icmp tcp"
PROBES=5
LOSS_OK=60
LAT_BAD=250
MARGIN=25
HOME_TRANSPORT=udp
declare -A BIAS=( [udp]=0 [icmp]=5 [tcp]=20 [camo]=30 )
# UDP_ONLY=1 keeps failover on datagram carriers (udp/icmp) only, so a
# TCP-wide throttle (observed from Iran: TCP collapses while UDP is fine)
# can never push the tunnel onto a TCP carrier that is being throttled.
UDP_ONLY=0
declare -A DATAGRAM=( [udp]=1 [icmp]=1 [tcp]=0 [camo]=0 )
[ -r "$CONFIG_DIR/failover.conf" ] && . "$CONFIG_DIR/failover.conf"
if [ "$UDP_ONLY" = 1 ]; then
  NEW_ORDER=""
  for t in $ORDER; do [ "${DATAGRAM[$t]:-0}" = 1 ] && NEW_ORDER="$NEW_ORDER $t"; done
  ORDER="${NEW_ORDER# }"
fi

exec 9>/run/norr-failover.lock
flock -n 9 || exit 0

declare -A IP TUN
while read -r _ role kind peer _ tun; do
  [ "$role" = client ] || continue
  [ -z "${IP[$kind]:-}" ] || continue
  IP[$kind]=$peer; TUN[$kind]=$tun
done < <("$NORR_CLI" tunnels --machine 2>/dev/null)

AVAILABLE=""
for t in $ORDER; do [ -n "${IP[$t]:-}" ] && AVAILABLE="$AVAILABLE $t"; done
[ -z "$AVAILABLE" ] && { logger -t norr-failover "no client tunnels found in $CONFIG_DIR"; exit 0; }

TAG="failover$PROBE_PORT"

measure() {
  local ip=${IP[$1]} ok=0 t0 t1; local -a v=()
  for _ in $(seq 1 "$PROBES"); do
    t0=$(date +%s%N)
    if timeout 2 bash -c "echo >/dev/tcp/$ip/$PROBE_PORT" 2>/dev/null; then
      t1=$(date +%s%N); v+=( $(( (t1 - t0) / 1000000 )) ); ok=$((ok + 1))
    fi
  done
  local pct=$(( ok * 100 / PROBES )) med=9999
  if [ $ok -gt 0 ]; then
    local -a sorted
    mapfile -t sorted < <(printf '%s\n' "${v[@]}" | sort -n)
    med=${sorted[$(( ok / 2 ))]}
  fi
  echo "$pct $med"
}

clear_rules() {
  local table rule
  for table in PREROUTING POSTROUTING; do
    while rule=$(iptables -t nat -S "$table" | grep -- "$TAG" | head -1) && [ -n "$rule" ]; do
      iptables -t nat -D "$table" ${rule#-A "$table" } || break
    done
  done
}

apply() {
  local t=$1
  clear_rules
  iptables -t nat -A PREROUTING ! -i "${TUN[$t]}" -p tcp --dport "$PROBE_PORT" -m addrtype --dst-type LOCAL \
    -m comment --comment "$TAG" -j DNAT --to-destination "${IP[$t]}:$PROBE_PORT"
  iptables -t nat -A POSTROUTING -d "${IP[$t]}/32" -o "${TUN[$t]}" -p tcp --dport "$PROBE_PORT" \
    -m comment --comment "$TAG" -j MASQUERADE
  echo "$t" > "$STATE"
  logger -t norr-failover "$PROBE_PORT -> $t (${IP[$t]}) loss=$((100 - LPCT))% rtt=${LAVG}ms"
}

: > "$METRICS"
declare -A PCT AVG
for t in $AVAILABLE; do
  read -r p a <<<"$(measure "$t")"
  PCT[$t]=$p; AVG[$t]=$a
  printf '%s loss=%s%% rtt=%sms\n' "$t" "$((100 - p))" "$a" >> "$METRICS"
done

is_healthy() { [ "${PCT[$1]}" -ge "$LOSS_OK" ] && [ "${AVG[$1]}" -le "$LAT_BAD" ]; }
score() { echo $(( AVG[$1] + ${BIAS[$1]:-0} )); }

promote() {
  if [ "$(cat "$HYST" 2>/dev/null)" = "$1" ]; then
    LPCT=${PCT[$1]}; LAVG=${AVG[$1]}; apply "$1"; rm -f "$HYST"
  else
    echo "$1" > "$HYST"
  fi
}

cur=$(cat "$STATE" 2>/dev/null)
[ -n "$cur" ] && [ -z "${IP[$cur]:-}" ] && cur=""

best=""; bestscore=99999
for t in $AVAILABLE; do
  is_healthy "$t" || continue
  sc=$(score "$t")
  [ "$sc" -lt "$bestscore" ] && { bestscore=$sc; best=$t; }
done

if [ -z "$best" ]; then
  bestloss=100
  for t in $AVAILABLE; do
    [ "${PCT[$t]}" -eq 0 ] && continue
    loss=$(( 100 - PCT[$t] ))
    if [ "$loss" -lt "$bestloss" ] || { [ "$loss" -eq "$bestloss" ] && [ -n "$best" ] && [ "${AVG[$t]}" -lt "${AVG[$best]}" ]; }; then
      bestloss=$loss; best=$t
    fi
  done
  if [ -z "$best" ]; then
    logger -t norr-failover "no reachable tunnel: $(tr '\n' ' ' < "$METRICS")"
    exit 0
  fi
  if [ "$best" != "$cur" ]; then
    LPCT=${PCT[$best]}; LAVG=${AVG[$best]}; apply "$best"
  fi
  rm -f "$HYST"; exit 0
fi

if [ -z "$cur" ] || ! is_healthy "$cur"; then
  LPCT=${PCT[$best]}; LAVG=${AVG[$best]}; apply "$best"; rm -f "$HYST"; exit 0
fi

if [ "$cur" != "$HOME_TRANSPORT" ] && [ -n "${IP[$HOME_TRANSPORT]:-}" ] && is_healthy "$HOME_TRANSPORT" &&
   [ "$(( $(score "$HOME_TRANSPORT") - bestscore ))" -le "$MARGIN" ]; then
  promote "$HOME_TRANSPORT"; exit 0
fi

if [ "$best" != "$cur" ] && [ "$(( $(score "$cur") - bestscore ))" -ge "$MARGIN" ]; then
  promote "$best"
else
  rm -f "$HYST"
fi
exit 0
